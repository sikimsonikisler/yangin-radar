<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Gelistirme sirasinda uygulama Mac'te calisan sunucuya duz HTTP ile baglanir.
	  NSAllowsLocalNetworking yalnizca yerel agi acar; genel internete duz HTTP
	  yine kapalidir. Sunucu HTTPS'e tasindiginda bu bolum tamamen silinebilir.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
