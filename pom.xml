<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.yanginradar</groupId>
    <artifactId>yangin-radar</artifactId>
    <version>1.0.0</version>
    <name>YanginRadar</name>
    <description>Turkiye yangin takip, ihbar ve fotograf dogrulamali canli veri akisi</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Apple App Attest dogrulamasi: fotografin gercekten bizim imzali
             uygulamamizdan, gercek bir Apple cihazindan geldigini kanitlar.
             CBOR cozumlemesi ve Apple kok sertifika zinciri dogrulamasi burada. -->
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-appattest</artifactId>
            <version>0.29.1.RELEASE</version>
        </dependency>

        <!-- EXIF / GPS / cekim zamani okuma: fotograf dogrulamanin temeli -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.19.0</version>
        </dependency>

        <!-- Sema gocu. `ddl-auto: update` dolu bir tabloya NOT NULL sutun
             ekleyemiyor ve sessizce basarisiz oluyordu; sema artik burada,
             sirali gocdosyalariyla yonetiliyor. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Gelistirirken kaynak/statik dosya degisiminde otomatik yeniden yukleme.
             IntelliJ'de calismasi icin "Build project automatically" acik olmali. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
